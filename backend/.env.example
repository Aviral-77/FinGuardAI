# FinGuard AI — configuration
# Copy to `backend/.env` and adjust. Nothing here is required: every value
# falls back to a safe default, and the stage demo runs with this file absent.
# Real exported environment variables override anything set here.

# ---------------------------------------------------------------------------
# Investigator copilot — case narrative
# ---------------------------------------------------------------------------
# Per DEMO-SPEC the default narrative is the deterministic template composer:
# instant, never fails live, identical every run. Set a provider only when you
# want an LLM to rewrite the same facts into prose. The LLM never computes a
# score or chooses an action.
#   none | gemini | anthropic
FINGUARD_LLM_PROVIDER=none

# Google Gemini (used when FINGUARD_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
FINGUARD_GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (used when FINGUARD_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
FINGUARD_ANTHROPIC_MODEL=claude-sonnet-5

FINGUARD_LLM_MAX_TOKENS=700
# FINGUARD_LLM_CACHE_DIR=app/copilot/cache

# ---------------------------------------------------------------------------
# Anomaly (ML) layer
# ---------------------------------------------------------------------------
# The stage demo uses no ML (rules do the detection). This switch controls the
# batch/replay analysis only; the live presenter demo forces ML off regardless.
FINGUARD_ML_ENABLED=true
# FINGUARD_IFOREST_ESTIMATORS=200
# FINGUARD_IFOREST_CONTAMINATION=0.06
# FINGUARD_IFOREST_MAX_SAMPLES=256

# ---------------------------------------------------------------------------
# Determinism
# ---------------------------------------------------------------------------
# FINGUARD_SEED=42
# FINGUARD_BACKGROUND_ACCOUNTS=210

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
FINGUARD_HOST=127.0.0.1
FINGUARD_PORT=8000
FINGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
